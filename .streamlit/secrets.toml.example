# Example only: placeholder values, safe to commit.
# Copy this file to .streamlit/secrets.toml (ignored by git) and fill in your own Supabase project values.
# On Streamlit Community Cloud, paste the same lines into the app's Settings → Secrets instead.
# Both are optional: without them the game runs with guest progress only.

SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_YOUR_KEY"
